# Everything here is optional. There is no LLM configuration: Claude Code is the optimizer.

# Modal (GPU execution): either run `modal setup` once (stores a token in ~/.modal.toml) and leave these blank,
# or set both here, e.g. for CI / remote machines.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# GPU to run on (default H100). The nvcc arch and the roofline peaks follow from it.
MODAL_GPU=H100
