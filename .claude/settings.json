{
  "permissions": {
    "allow": [
      "Bash(./optk:*)",
      "Edit(/workspace/**)",
      "Write(/workspace/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/bin/python -m agent.hooklog pre", "async": true, "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/bin/python -m agent.hooklog post", "async": true, "timeout": 10 }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/bin/python -m agent.hooklog postfail", "async": true, "timeout": 10 }]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/bin/python -m agent.hooklog perm", "async": true, "timeout": 10 }]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/bin/python -m agent.hooklog permdenied", "async": true, "timeout": 10 }]
      }
    ],
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/bin/python -m agent.hooklog notify", "async": true, "timeout": 10 }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{ "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/bin/python -m agent.hooklog substart", "async": true, "timeout": 10 }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/bin/python -m agent.hooklog substop", "async": true, "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/bin/python -m agent.hooklog stop", "async": true, "timeout": 10 }]
      }
    ]
  }
}
